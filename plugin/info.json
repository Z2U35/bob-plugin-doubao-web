{
  "identifier": "com.z2u35.bob.doubaoweb",
  "version": "0.2.0",
  "category": "translate",
  "name": "豆包网页翻译",
  "summary": "豆包网页翻译；支持本机登录助手自动获取会话，也可手动填写 Cookie。非官方测试版。",
  "icon": "132",
  "author": "Z2U35",
  "homepage": "https://github.com/Z2U35/bob-plugin-doubao-web",
  "appcast": "https://raw.githubusercontent.com/Z2U35/bob-plugin-doubao-web/main/appcast.json",
  "minBobVersion": "1.21.0",
  "icons": [
    { "identifier": "doubao", "type": "builtIn", "builtInId": "132" },
    { "identifier": "volc", "type": "builtIn", "builtInId": "120" },
    { "identifier": "microsoft", "type": "builtIn", "builtInId": "122" }
  ],
  "options": [
    {
      "identifier": "loginMode",
      "type": "menu",
      "title": "登录方式",
      "defaultValue": "auto",
      "menuValues": [
        { "title": "自动：登录助手（已填 Cookie 时优先使用 Cookie）", "value": "auto" },
        { "title": "仅登录助手", "value": "helper" },
        { "title": "手动 Cookie", "value": "manual" }
      ],
      "desc": "自动模式需安装并保持 Doubao Login Helper 运行。在助手内完成豆包官方登录，首次验证时核对一次配对码；无需手动找 Cookie。"
    },
    {
      "identifier": "service",
      "type": "menu",
      "title": "翻译服务",
      "defaultValue": "1",
      "isKeyOption": true,
      "menuValues": [
        { "title": "豆包翻译", "value": "1", "defaultPluginIconIdentifier": "doubao", "defaultPluginName": "豆包网页翻译" },
        { "title": "豆包·火山翻译", "value": "0", "defaultPluginIconIdentifier": "volc", "defaultPluginName": "豆包·火山网页翻译" },
        { "title": "豆包·微软翻译", "value": "3", "defaultPluginIconIdentifier": "microsoft", "defaultPluginName": "豆包·微软网页翻译" }
      ],
      "desc": "三个选项都经过豆包网页接口，不是火山方舟或微软付费 API。"
    },
    {
      "identifier": "cookie",
      "type": "text",
      "title": "Cookie（手动模式可选）",
      "defaultValue": "",
      "textConfig": {
        "type": "secure",
        "height": 44,
        "placeholderText": "粘贴豆包请求头 Cookie 的完整值（不是 API Key）"
      },
      "desc": "使用助手时留空。手动模式从已登录的 www.doubao.com 请求头复制；过期后自行更新。验证会发送 Hello, world! 测试。不要分享 Cookie。"
    },
    {
      "identifier": "userAgent",
      "type": "text",
      "title": "User-Agent（可选）",
      "defaultValue": "",
      "textConfig": {
        "type": "visible",
        "placeholderText": "一般留空；如被拒绝，可填写同一浏览器请求头的 User-Agent 值"
      },
      "desc": "用于匹配登录浏览器的客户端信息。不需要填写整行请求头。"
    }
  ]
}
